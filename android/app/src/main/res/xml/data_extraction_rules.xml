<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local SQLite database and Drift database files -->
        <exclude domain="database" path="." />
        <!-- Exclude SharedPreferences (includes flutter_secure_storage keys) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude root internal storage files -->
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude financial databases and encrypted keys from device-to-device transfers -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
